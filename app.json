{
  "expo": {
    "name": "MyOrbit",
    "slug": "daypilot",
    "scheme": "daypilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daypilot.personal",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSFaceIDUsageDescription": "MyOrbit uses Face ID to unlock your data when App Lock is on.",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "UXQ2VPYB93"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MyOrbit uses Face ID to unlock your data when App Lock is on."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DayPilotToday",
              "displayName": "MyOrbit Today",
              "description": "Next activity, today\u2019s schedule, tasks and habits.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/TodayWidget.tsx"
              }
            }
          ]
        }
      ],
      "expo-sharing",
      "./plugins/withAppIntents.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
